# ─────────────────────────────────────────────────────────────────────────────
# HoCAID Website — Environment Variables
# Copy this file to .env.local and fill in real values before running locally.
# .env.local is gitignored and must NEVER be committed.
# On Vercel: add these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Site URL — used for sitemap.xml, robots.txt, and OpenGraph metadataBase.
# No trailing slash. In production this must be the canonical domain.
NEXT_PUBLIC_SITE_URL=https://hocaid.org

# Google Analytics 4 — Measurement ID (e.g. G-XXXXXXXXXX)
# Get this from: analytics.google.com → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Paystack — Donation integration
# Get these from: paystack.com → Settings → API Keys
# Use pk_test_ / sk_test_ keys for development; swap for pk_live_ / sk_live_ in production.

# Public key — safe to expose to the browser (NEXT_PUBLIC_ prefix required by Next.js)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server-only. NEVER expose to the browser or commit to version control.
# Used in app/api/paystack/webhook/route.ts for HMAC SHA-512 signature verification.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
